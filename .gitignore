# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# carpeta de descarte usada por el puente de archivos del asistente en local
# (device_bash no puede borrar, así que mueve ahí lo que hay que eliminar) —
# nunca debe llegar al build ni al repo.
/_to_delete/

# typescript
*.tsbuildinfo
next-env.d.ts
